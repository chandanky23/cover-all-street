{
  "expo": {
    "name": "Duppy Map",
    "slug": "duppy-map",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "duppymap",
    "userInterfaceStyle": "light",
    "backgroundColor": "#FFF7E9",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.duppymap.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.duppymap.app",
      "adaptiveIcon": {
        "backgroundColor": "#FFF7E9",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "allowBackup": false
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFF7E9",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-sqlite",
      "@maplibre/maplibre-react-native",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Duppy Map records streets you walk so it can paint them on your map, even while your phone is locked.",
          "locationAlwaysPermission": "Duppy Map records streets you walk so it can paint them on your map, even while your phone is locked.",
          "locationWhenInUsePermission": "Duppy Map uses your location to show where you are on the map and track streets you've explored.",
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      "expo-asset",
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
